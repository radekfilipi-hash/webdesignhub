# Zkopíruj tento soubor jako  deploy-wedos.env  a vyplň reálné údaje.
# deploy-wedos.env je v .gitignore – NIKDY se necommituje.

# FTP hostname z Wedos administrace (Webhosting -> FTP účty).
# Bývá např. wXXXXX.wedos.net  nebo přímo  webdesignhub.cz
WEDOS_FTP_HOST=webdesignhub.cz

# FTP uživatel a heslo (Wedos: Webhosting -> Správa FTP účtů)
WEDOS_FTP_USER=
WEDOS_FTP_PASS=

# Vzdálený docroot webu. Na Wedosu bývá web ve složce "www".
# Nejdřív se přihlas FileZillou a podívej se, kam tě to pustí:
#  - když po přihlášení vidíš složku "www"  -> nastav WEDOS_FTP_DIR=/www/
#  - když rovnou vidíš staré index/soubory  -> nastav WEDOS_FTP_DIR=/
WEDOS_FTP_DIR=/www/

# 1 = vynutit šifrované FTPS (doporučeno). Když Wedos FTPS nepodporuje, dej 0.
WEDOS_FTP_TLS=1
# 1 = neověřovat TLS certifikát (jen když FTPS hlásí chybu certifikátu)
WEDOS_FTP_INSECURE=0
